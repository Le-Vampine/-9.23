\@writefile{toc}{\contentsline {subsubsection}{\numberline {5\,.\,2\,.\,20}验证集基础性能与解释维度错误归因}{42}{subsubsection.5.2.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces 预测正确与错误样本的解释熵（左）与置信度（右）箱线图。错误样本的解释熵中位数 高于正确样本，说明其模态依赖更分散、缺少明确的判断依据；置信度分布也整体左移，中位数差约 0.03。箱体上下缘为四分位数，须线延伸至 1.5 倍四分位距内的极值，离群点以散点单独标出；两组在解释熵上的差异比置信度更稳定。}}{43}{figure.caption.47}\protected@file@percent }
\newlabel{fig:q3err}{{31}{43}{预测正确与错误样本的解释熵（左）与置信度（右）箱线图。错误样本的解释熵中位数 高于正确样本，说明其模态依赖更分散、缺少明确的判断依据；置信度分布也整体左移，中位数差约 0.03。箱体上下缘为四分位数，须线延伸至 1.5 倍四分位距内的极值，离群点以散点单独标出；两组在解释熵上的差异比置信度更稳定。}{figure.caption.47}{}}
\newlabel{fig:q3err@cref}{{[figure][31][]31}{[1][42][]43}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces 解释维度的错误归因（验证集 728 条）。解释熵为模态作用度分布的香农熵， 熵越大表示模态依赖越分散、判断依据越不明确。错误样本的解释熵高于正确样本，而文本作用度 与置信度均更低，说明模型在易错样本上依赖更分散，与问题二中弱强度样本分类准确率仅 0.5045 的结论相互支持。}}{43}{table.caption.48}\protected@file@percent }
\newlabel{tab:q3err}{{14}{43}{解释维度的错误归因（验证集 728 条）。解释熵为模态作用度分布的香农熵， 熵越大表示模态依赖越分散、判断依据越不明确。错误样本的解释熵高于正确样本，而文本作用度 与置信度均更低，说明模型在易错样本上依赖更分散，与问题二中弱强度样本分类准确率仅 0.5045 的结论相互支持。}{table.caption.48}{}}
