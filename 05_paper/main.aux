\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 缺失类型与缺失位置的退化热力图。行表示缺失类型，列表示缺失位置，单元格数值为相对基线的误差增量，颜色越深表示退化越严重。文本类所在的整行明显深于语音与视觉行，其中头部缺失格的数值最高。语音与视觉行在全列上数值接近零，说明这两类模态的缺失位置对结果几无影响。}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:q2heat}{{9}{16}{缺失类型与缺失位置的退化热力图。行表示缺失类型，列表示缺失位置，单元格数值为相对基线的误差增量，颜色越深表示退化越严重。文本类所在的整行明显深于语音与视觉行，其中头部缺失格的数值最高。语音与视觉行在全列上数值接近零，说明这两类模态的缺失位置对结果几无影响。}{figure.caption.13}{}}
