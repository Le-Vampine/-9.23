\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces 中性样本 03 的解释卡，四个子图含义同图~\ref {fig:q3cards}。该样本预测强度 $-0.2985$、置信度 0.4954，属边界样本；三模态作用度为文本 0.468、语音 0.264、视觉 0.267，时间重要性在各模态内亦较均匀，说明模型未找到单一强证据，与错误归因中“边界样本解释熵更高”的结论一致。该卡补齐了正向、中性与负向三类典型样本的解释展示。}}{33}{figure.caption.33}\protected@file@percent }
\newlabel{fig:q3cards3}{{22}{33}{中性样本 03 的解释卡，四个子图含义同图~\ref {fig:q3cards}。该样本预测强度 $-0.2985$、置信度 0.4954，属边界样本；三模态作用度为文本 0.468、语音 0.264、视觉 0.267，时间重要性在各模态内亦较均匀，说明模型未找到单一强证据，与错误归因中“边界样本解释熵更高”的结论一致。该卡补齐了正向、中性与负向三类典型样本的解释展示。}{figure.caption.33}{}}
\newlabel{fig:q3cards3@cref}{{[figure][22][]22}{[1][32][]33}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces 负向样本 16 的解释卡，四子图含义同图~\ref {fig:q3cards}。该样本预测强度为 $-2.54$，属强负向，文本作用度升至 0.8731，关键片段集中在含有否定作用的词上； 语音与视觉的作用度相应下降，说明在强情感样本上模型更依赖文本语义，与 \ref {sec:q3consist} 小节按强度分层的统计结论一致。}}{34}{figure.caption.34}\protected@file@percent }
\newlabel{fig:q3cards2}{{23}{34}{负向样本 16 的解释卡，四子图含义同图~\ref {fig:q3cards}。该样本预测强度为 $-2.54$，属强负向，文本作用度升至 0.8731，关键片段集中在含有否定作用的词上； 语音与视觉的作用度相应下降，说明在强情感样本上模型更依赖文本语义，与 \ref {sec:q3consist} 小节按强度分层的统计结论一致。}{figure.caption.34}{}}
\newlabel{fig:q3cards2@cref}{{[figure][23][]23}{[1][33][]34}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces 正向样本 17 的解释卡。四个子图自上而下、自左向右依次为：三模态时间重要性 条带（虚线为该模态有效长度上界，三角为排名前三的关键片段）、文本证据的词级着色 （橙色为模型关注的词，方框为可回看的字符区间）、视觉关键帧、以及音频能量曲线 与高重要度的语音时段（阴影）。该样本真实强度为强正向，模态作用度以文本最大， 关键证据落在情绪极性词上。}}{35}{figure.caption.35}\protected@file@percent }
\newlabel{fig:q3cards}{{24}{35}{正向样本 17 的解释卡。四个子图自上而下、自左向右依次为：三模态时间重要性 条带（虚线为该模态有效长度上界，三角为排名前三的关键片段）、文本证据的词级着色 （橙色为模型关注的词，方框为可回看的字符区间）、视觉关键帧、以及音频能量曲线 与高重要度的语音时段（阴影）。该样本真实强度为强正向，模态作用度以文本最大， 关键证据落在情绪极性词上。}{figure.caption.35}{}}
\newlabel{fig:q3cards@cref}{{[figure][24][]24}{[1][34][]35}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5\,.\,2\,.\,18}三模态作用差异与一致性检验}{35}{subsubsection.5.2.18}\protected@file@percent }
\newlabel{sec:q3consist}{{5\,.\,2\,.\,18}{35}{三模态作用差异与一致性检验}{subsubsection.5.2.18}{}}
\newlabel{sec:q3consist@cref}{{[subsubsection][18][5,2]5\,.\,2\,.\,18}{[1][35][]35}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 验证集上三模态作用度按真值极性分层。作用度取 softmax 归一化口径并逐样本计算后 取组内均值（式~\eqref  {eq:q3norm}）。三类情感的文本作用度分别为 0.514/0.407/0.460， 语音与视觉的组间差异均小于 0.065。文本在三类情感中均为最大作用模态， 且在强情感样本上更突出，说明模型以文本语义为主、语音与视觉为辅。}}{35}{table.caption.36}\protected@file@percent }
\newlabel{tab:q3pi}{{9}{35}{验证集上三模态作用度按真值极性分层。作用度取 softmax 归一化口径并逐样本计算后 取组内均值（式~\eqref {eq:q3norm}）。三类情感的文本作用度分别为 0.514/0.407/0.460， 语音与视觉的组间差异均小于 0.065。文本在三类情感中均为最大作用模态， 且在强情感样本上更突出，说明模型以文本语义为主、语音与视觉为辅。}{table.caption.36}{}}
\newlabel{tab:q3pi@cref}{{[table][9][]9}{[1][35][]35}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces 验证集三模态作用度按真值极性分层的箱线图，三个子图依次为文本、语音与视觉， 箱体为四分位区间。文本作用度在三类情感上均显著高于另两个模态，且负向与正向样本的 中位数高于中性样本，说明情感越明确、文本依据越集中；语音与视觉的分布在三类之间高度重叠， 其辅助作用不随极性方向变化。}}{36}{figure.caption.37}\protected@file@percent }
\newlabel{fig:q3pilab}{{25}{36}{验证集三模态作用度按真值极性分层的箱线图，三个子图依次为文本、语音与视觉， 箱体为四分位区间。文本作用度在三类情感上均显著高于另两个模态，且负向与正向样本的 中位数高于中性样本，说明情感越明确、文本依据越集中；语音与视觉的分布在三类之间高度重叠， 其辅助作用不随极性方向变化。}{figure.caption.37}{}}
\newlabel{fig:q3pilab@cref}{{[figure][25][]25}{[1][35][]36}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces 八个子集的模态组合在验证集上的表现与全局 Shapley 值。子集含义为使用哪些模态 （“无”表示三个模态全部屏蔽）。文本单独使用即可把平均绝对误差由 0.7816 降到 0.5936， 接近全模态的 0.5890，而语音或视觉单独使用几乎无效；全局 Shapley 值给出同样的排序： 文本 0.1842、语音 0.0004、视觉 0.0103 （以负平均绝对误差为效用）。}}{36}{table.caption.38}\protected@file@percent }
\newlabel{tab:q3subset}{{10}{36}{八个子集的模态组合在验证集上的表现与全局 Shapley 值。子集含义为使用哪些模态 （“无”表示三个模态全部屏蔽）。文本单独使用即可把平均绝对误差由 0.7816 降到 0.5936， 接近全模态的 0.5890，而语音或视觉单独使用几乎无效；全局 Shapley 值给出同样的排序： 文本 0.1842、语音 0.0004、视觉 0.0103 （以负平均绝对误差为效用）。}{table.caption.38}{}}
\newlabel{tab:q3subset@cref}{{[table][10][]10}{[1][36][]36}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces 样本级一致性检验。横轴为删去该模态后验证集平均绝对误差的增量，纵轴为模型给出的 该模态作用度，三种颜色对应三个模态，全部 728 条样本点叠绘。两者的秩相关系数为 1.000，散点整体沿右上方向分布，说明作用度高的模态确实对应更大的预测退化。}}{37}{figure.caption.39}\protected@file@percent }
\newlabel{fig:q3consist}{{26}{37}{样本级一致性检验。横轴为删去该模态后验证集平均绝对误差的增量，纵轴为模型给出的 该模态作用度，三种颜色对应三个模态，全部 728 条样本点叠绘。两者的秩相关系数为 1.000，散点整体沿右上方向分布，说明作用度高的模态确实对应更大的预测退化。}{figure.caption.39}{}}
\newlabel{fig:q3consist@cref}{{[figure][26][]26}{[1][36][]37}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces 免标注机制验证。横轴为该模态的实测缺失率，纵轴为该模态的作用度，圆点与三角分别 为附件三与附件四的样本。随缺失率上升作用度下降，说明模型在信息缺失时确实降低了对该模态的 依赖，该检验不使用任何人工标注，可作为解释合理性的独立旁证；两套数据的点位分布一致，说明该趋势并非由单一测试集的构成所致。}}{38}{figure.caption.40}\protected@file@percent }
\newlabel{fig:q3miss}{{27}{38}{免标注机制验证。横轴为该模态的实测缺失率，纵轴为该模态的作用度，圆点与三角分别 为附件三与附件四的样本。随缺失率上升作用度下降，说明模型在信息缺失时确实降低了对该模态的 依赖，该检验不使用任何人工标注，可作为解释合理性的独立旁证；两套数据的点位分布一致，说明该趋势并非由单一测试集的构成所致。}{figure.caption.40}{}}
\newlabel{fig:q3miss@cref}{{[figure][27][]27}{[1][37][]38}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces 四种解释来源在附件四上的解释质量对比。忠实性为删除 top-5 片段后预测的变化量， 充分性偏差为仅保留 top-5 片段时与全模态预测的差距，稀疏性为 top-5 片段的权重占比。 注意力源（基线）在两项忠实性指标上均为最差，积分梯度与遮挡源更好，融合结果在忠实性与 稀疏性之间取得折中。}}{39}{figure.caption.41}\protected@file@percent }
\newlabel{fig:q3faith}{{28}{39}{四种解释来源在附件四上的解释质量对比。忠实性为删除 top-5 片段后预测的变化量， 充分性偏差为仅保留 top-5 片段时与全模态预测的差距，稀疏性为 top-5 片段的权重占比。 注意力源（基线）在两项忠实性指标上均为最差，积分梯度与遮挡源更好，融合结果在忠实性与 稀疏性之间取得折中。}{figure.caption.41}{}}
\newlabel{fig:q3faith@cref}{{[figure][28][]28}{[1][38][]39}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces 解释质量指标的定量结果（附件四 20 条样本，均值）。忠实性为删除 top-5 片段后 预测的符号均值与绝对变化量，充分性偏差为只保留 top-5 片段时与全模态预测差距的绝对值均值， 稀疏性为 top-5 片段在有效位内的权重占比。注意力源的忠实性最低，与遮挡源的秩相关仅 -0.0268，说明在本模型上直接以注意力权重作为解释并不成立；本文因此以 最终解释取三源融合结果。}}{39}{table.caption.42}\protected@file@percent }
\newlabel{tab:q3faith}{{11}{39}{解释质量指标的定量结果（附件四 20 条样本，均值）。忠实性为删除 top-5 片段后 预测的符号均值与绝对变化量，充分性偏差为只保留 top-5 片段时与全模态预测差距的绝对值均值， 稀疏性为 top-5 片段在有效位内的权重占比。注意力源的忠实性最低，与遮挡源的秩相关仅 -0.0268，说明在本模型上直接以注意力权重作为解释并不成立；本文因此以 最终解释取三源融合结果。}{table.caption.42}{}}
\newlabel{tab:q3faith@cref}{{[table][11][]11}{[1][39][]39}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces 附件四全部 20 条样本的逐段重要性热力图，三行自上而下为文本、语音、视觉，每行一条 样本，样本按模型预测强度升序排列；单元格颜色越深表示该段越关键，红色竖线为各样本的有效长度 上界，其右侧为填充位且恒为零。高亮段集中在有效区间的前中部，文本行的高亮对比度明显强于语音 与视觉，说明模型对文本的时间定位更集中、分辨率更高。}}{40}{figure.caption.43}\protected@file@percent }
